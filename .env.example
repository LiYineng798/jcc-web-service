# Reference only: Python entry points do not automatically load .env.
# Set process environment variables (PowerShell $env:NAME or systemd EnvironmentFile).
JCC_SECRET_KEY=change-me-to-a-random-long-string
JCC_ADMIN_USERNAME=admin
JCC_ADMIN_PASSWORD=LocalDev1234

# Omit for local SQLite: instance/lineups.sqlite3.
# SQLite URL paths do not override config.DATABASE; see docs/architecture.md.
# JCC_DATABASE_URL=postgresql://jcc_app:replace-with-password@127.0.0.1:5432/jcc

# HTTPS production only; keep false for local HTTP.
JCC_SESSION_COOKIE_SECURE=false
JCC_SESSION_DAYS=30

# Token upload endpoints; empty disables this upload path.
JCC_LIVE_COMPS_UPLOAD_TOKEN=
# JCC_LIVE_COMPS_DEFAULT_SEASON_ID=s17-star-god

# Web and the independent worker must share this persistent, private directory.
# Default: instance/season-packages.
# JCC_SEASON_PACKAGE_ROOT=/opt/jcc/season-library

# Optional password-reset email delivery.
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Site <no-reply@example.com>
JCC_PASSWORD_RESET_CODE_TTL_MINUTES=10
JCC_PASSWORD_RESET_COOLDOWN_SECONDS=60
