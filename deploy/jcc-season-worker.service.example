[Unit]
Description=JCC season upload validation worker
After=network.target postgresql.service

[Service]
Type=simple
User=jcc
Group=jcc
WorkingDirectory=/srv/example-jcc/jcc-web-service
EnvironmentFile=/etc/example-jcc.env
Environment=JCC_PROCESS_ROLE=season-worker
ExecStart=/srv/example-jcc/jcc-web-service/.venv/bin/python season_package_worker.py
Restart=on-failure
RestartSec=5
Nice=10
MemoryMax=768M
CPUQuota=75%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/example-jcc/season-library /srv/example-jcc/jcc-web-service/instance
UMask=0027

[Install]
WantedBy=multi-user.target
