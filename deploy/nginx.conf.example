server {
    listen 80;
    server_name jcc.np5.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name jcc.np5.top;

    ssl_certificate /etc/letsencrypt/live/jcc.np5.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jcc.np5.top/privkey.pem;

    # 文本压缩：HTML/CSS/JS/JSON/SVG（图片本身已压缩，无需 gzip）
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    # 静态文件由 nginx 直接服务，不经过 Python worker。
    # 站点 CSS/JS 引用带 ?v= 版本号，图片路径由数据版本决定，可放心长缓存。
    location /static/ {
        alias /opt/jcc/jcc-web-service/static/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    location = /favicon.ico {
        alias /opt/jcc/jcc-web-service/static/favicon.ico;
        expires 30d;
        access_log off;
    }

    # 实况阵容缓存图片（上传后内容不变，按文件名区分）
    location /api/live-comps/assets/ {
        alias /opt/jcc/jcc-web-service/instance/live-comps-assets/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
