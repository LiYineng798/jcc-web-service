[Unit]
Description=JCC Lineup Manager
After=network.target

[Service]
User=jcc
Group=jcc
WorkingDirectory=/opt/jcc/jcc-web-service
EnvironmentFile=/etc/jcc.env
ExecStart=/opt/jcc/jcc-web-service/.venv/bin/gunicorn -c deploy/gunicorn.conf.py --bind 127.0.0.1:5054 --timeout 120 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
